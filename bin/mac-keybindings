#!/bin/bash
# Omarchy's keybindings menu, with shortcuts written the way macOS menus write
# them: ⇧⌘↩ rather than SUPER SHIFT + RETURN.
#
#   mac-keybindings           open the menu and run the binding you pick
#   mac-keybindings --print   print the list
#
# Collecting, caching and running bindings stay Omarchy's job. This loads the
# function definitions from omarchy-menu-keybindings, which sit above its menu
# code, and rewrites only the shortcut in front of each arrow.

set -o pipefail

omarchy_menu=$(command -v omarchy-menu-keybindings) || {
  echo "mac-keybindings: omarchy-menu-keybindings not found" >&2
  exit 1
}

# Everything above its last top-level `if`, the menu itself, is function
# definitions. If that ever stops holding, open Omarchy's own menu rather than
# none.
definitions=$(awk '/^if / { last = NR } { line[NR] = $0 } END { for (i = 1; i < last; i++) print line[i] }' "$omarchy_menu")
eval "$definitions"
if ! declare -F output_binding_records dispatch_binding >/dev/null; then
  exec omarchy-menu-keybindings "$@"
fi

# Records are "SHORTCUT → Action<TAB>dispatcher<TAB>arg". Modifiers print in
# the order macOS menus use, ⌃⌥⇧⌘, then the key as its glyph or name.
to_mac_glyphs() {
  gawk -F '\t' -v OFS='\t' '
    BEGIN {
      glyph["CTRL"] = "⌃"; glyph["CONTROL"] = "⌃"; glyph["ALT"] = "⌥"
      glyph["SHIFT"] = "⇧"; glyph["SUPER"] = "⌘"
      order = "⌃⌥⇧⌘"

      keys = "RETURN=↩ ENTER=↩ KP_ENTER=⌤ TAB=⇥ BACKSPACE=⌫ DELETE=⌦ ESCAPE=⎋ ESC=⎋ " \
             "LEFT=← RIGHT=→ UP=↑ DOWN=↓ HOME=↖ END=↘ PRIOR=⇞ PAGE_UP=⇞ NEXT=⇟ PAGE_DOWN=⇟ " \
             "SPACE=Space COMMA=, PERIOD=. MINUS=- EQUAL== SLASH=/ BACKSLASH=\\ SEMICOLON=; " \
             "APOSTROPHE=\x27 GRAVE=` BRACKETLEFT=[ BRACKETRIGHT=] PRINT=PrtSc CAPS_LOCK=⇪"
      n = split(keys, pairs, " ")
      for (i = 1; i <= n; i++) {
        at = index(pairs[i], "=")
        name[substr(pairs[i], 1, at - 1)] = substr(pairs[i], at + 1)
      }

      # Media keys by what they are labelled on the keyboard. Others fall back
      # to their XF86 name split into words.
      n = split("AUDIORAISEVOLUME:Volume Up|AUDIOLOWERVOLUME:Volume Down|AUDIOMUTE:Mute|" \
                "AUDIOMICMUTE:Mic Mute|AUDIOPLAY:Play|AUDIOPAUSE:Pause|AUDIONEXT:Next|" \
                "AUDIOPREV:Previous|MONBRIGHTNESSUP:Brightness Up|MONBRIGHTNESSDOWN:Brightness Down|" \
                "KBDBRIGHTNESSUP:Keyboard Light Up|KBDBRIGHTNESSDOWN:Keyboard Light Down", pairs, "|")
      for (i = 1; i <= n; i++) {
        at = index(pairs[i], ":")
        media["XF86" substr(pairs[i], 1, at - 1)] = substr(pairs[i], at + 1)
      }
    }
    {
      arrow = index($1, " → ")
      if (arrow == 0) { print; next }

      shortcut = substr($1, 1, arrow - 1)
      action = substr($1, arrow + length(" → "))
      sub(/[[:space:]]+$/, "", shortcut)

      # "SUPER SHIFT + RETURN": modifiers before " + ", the key after it.
      split_at = index(shortcut, " + ")
      mods = split_at ? substr(shortcut, 1, split_at - 1) : ""
      key = split_at ? substr(shortcut, split_at + 3) : shortcut

      held = ""
      m = split(toupper(mods), words, " ")
      for (i = 1; i <= m; i++) if (words[i] in glyph) held = held glyph[words[i]]

      symbols = ""
      for (i = 1; i <= length(order); i++) {
        g = substr(order, i, 1)
        if (index(held, g)) symbols = symbols g
      }

      upper = toupper(key)
      if (upper in name) key = name[upper]
      else if (upper in media) key = media[upper]
      else if (upper ~ /^XF86/) {
        key = substr(key, 5)
        gsub(/[A-Z][a-z]+/, " &", key)
        sub(/^ /, "", key)
      }
      else if (upper == "LEFT MOUSE BUTTON") key = "Click"
      else if (upper == "RIGHT MOUSE BUTTON") key = "Right-click"
      else if (upper == "MIDDLE MOUSE BUTTON") key = "Middle-click"
      else if (upper == "MOUSE_DOWN") key = "Scroll ↓"
      else if (upper == "MOUSE_UP") key = "Scroll ↑"

      $1 = sprintf("%-16s → %s", symbols key, action)
      print
    }'
}

records=$(output_binding_records | to_mac_glyphs) || exit 1

if [[ ${1-} == "--print" || ${1-} == "-p" ]]; then
  cut -f1 <<<"$records"
  exit 0
fi

picked=$(cut -f1 <<<"$records" | omarchy-menu-select 'Keybindings' -- --width 800 --height 500)
[[ -n $picked ]] || exit 0

record=$(awk -F '\t' -v picked="$picked" '$1 == picked { print; exit }' <<<"$records")
dispatch_binding "$(cut -f2 <<<"$record")" "$(cut -f3- <<<"$record")"
