#   of this software and associated documentation files (the "Software"), to
#   deal in the Software without restriction, including without limitation the
#   rights to use, copy, modify, merge, publish, distribute, sublicense, and/or
#   sell copies of the Software, and to permit persons to whom the Software is
#   furnished to do so, subject to the following conditions:
#
#   The above copyright notice and this permission notice shall be included in
#   all copies or substantial portions of the Software.
#
#   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
#   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
#   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
#   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
#   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
#   FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS
#   IN THE SOFTWARE.
#
# Omarchy's keybindings screen, in Mac key names.
#
#   mac-keybindings            the menu (what ⌘K opens while keynames is on)
#   mac-keybindings --print    the list, for a terminal or a grep
#
# Omarchy's screen spells every shortcut the way Hyprland stores it:
# "SUPER SHIFT + RETURN". A Mac user looks for Shift-Command-Return and finds a vocabulary
# they have to translate on the way to the key. This shows the same list,
# worded the way a Mac menu would word it.
#
# Only the wording is ours. The bindings, their order, the cache and what
# running one does all come from omarchy-menu-keybindings itself: its functions
# are loaded here and everything above the menu is left to them, so a binding
# Omarchy adds next week shows up here without anyone touching this file. What
# gets rewritten is the left-hand column and nothing else.
#
# If Omarchy's script ever changes shape and its functions cannot be loaded,
# this hands over to it untranslated. The wrong key names are a much smaller
# problem than no keybindings screen at all.

set -o pipefail

OMARCHY_KEYBINDINGS="$(command -v omarchy-menu-keybindings || true)"

upstream() { exec omarchy-menu-keybindings "$@"; }

[[ -n $OMARCHY_KEYBINDINGS ]] || { echo "omarchy-menu-keybindings not found" >&2; exit 1; }

# Everything before its entry point is function definitions. Loading that part
# gives us the functions without running its menu.
functions_src="$(sed '/^if \[\[ \$1 == "--print"/,$d' "$OMARCHY_KEYBINDINGS")"
[[ -n $functions_src && $functions_src != "$(cat "$OMARCHY_KEYBINDINGS")" ]] || upstream "$@"
eval "$functions_src"
for fn in output_binding_records dispatch_binding; do
  declare -F "$fn" >/dev/null || upstream "$@"
done

# Records are "display<TAB>dispatcher<TAB>arg", display being
# "SUPER SHIFT + B                     → Browser". Rewrite the combination in
# the display field and pass the rest through untouched.
#
# Written the way Apple's own support pages write shortcuts: words, joined by
# hyphens, modifiers in the order macOS prints them — Control, Option, Shift,
# Command. So "Shift-Command-B", never "Command+Shift+B". Words rather than
# ⌃⌥⇧⌘ because the symbols are one more thing to learn, and the point of this
# screen is to be read at a glance. SUPER is Command because that is the key
# Apple's keyboards send it from; ALT is Option for the same reason.
macify() {
  LC_ALL=C.UTF-8 gawk -F '\t' -v OFS='\t' '
    BEGIN {
      n = split("CTRL:1 CONTROL:1 ALT:2 SHIFT:3 SUPER:4", pairs, " ")
      for (i = 1; i <= n; i++) { split(pairs[i], kv, ":"); rank[kv[1]] = kv[2] }
      word[1] = "Control"; word[2] = "Option"; word[3] = "Shift"; word[4] = "Command"

      # Keys with a Mac name. Anything not here keeps its own name, which for
      # letters, digits and F-keys is already right. Backspace is "Delete" on
      # a Mac keyboard, and Delete is "Forward Delete".
      n = split("RETURN=Return|ENTER=Return|KP_ENTER=Enter|TAB=Tab|SPACE=Space|ESCAPE=Escape|ESC=Escape" \
                "|BACKSPACE=Delete|DELETE=Forward Delete" \
                "|LEFT=Left Arrow|RIGHT=Right Arrow|UP=Up Arrow|DOWN=Down Arrow|HOME=Home|END=End" \
                "|PRIOR=Page Up|PAGE_UP=Page Up|NEXT=Page Down|PAGE_DOWN=Page Down" \
                "|COMMA=Comma|PERIOD=Period|MINUS=Minus|EQUAL=Equals|SLASH=Slash|BACKSLASH=Backslash" \
                "|SEMICOLON=Semicolon|APOSTROPHE=Quote|GRAVE=Grave Accent|BRACKETLEFT=Left Bracket" \
                "|BRACKETRIGHT=Right Bracket|PRINT=Print Screen|CAPS_LOCK=Caps Lock" \
                "|LEFT MOUSE BUTTON=Click|RIGHT MOUSE BUTTON=Right Click|MIDDLE MOUSE BUTTON=Middle Click" \
                "|MOUSE_DOWN=Scroll Down|MOUSE_UP=Scroll Up" \
                "|XF86AUDIORAISEVOLUME=Volume Up|XF86AUDIOLOWERVOLUME=Volume Down|XF86AUDIOMUTE=Mute" \
                "|XF86AUDIOMICMUTE=Mic Mute|XF86AUDIOPLAY=Play|XF86AUDIOPAUSE=Pause" \
                "|XF86AUDIONEXT=Next Track|XF86AUDIOPREV=Previous Track|XF86MONBRIGHTNESSUP=Brightness Up" \
                "|XF86MONBRIGHTNESSDOWN=Brightness Down|XF86KBDBRIGHTNESSUP=Keyboard Brightness Up" \
                "|XF86KBDBRIGHTNESSDOWN=Keyboard Brightness Down|XF86KBDLIGHTONOFF=Keyboard Light" \
                "|XF86POWEROFF=Power|XF86EJECT=Eject|XF86CALCULATOR=Calculator|XF86TOUCHPADTOGGLE=Trackpad Toggle" \
                "|XF86TOUCHPADON=Trackpad On|XF86TOUCHPADOFF=Trackpad Off", keys, "|")
      for (i = 1; i <= n; i++) {
        eq = index(keys[i], "=")
        name[substr(keys[i], 1, eq - 1)] = substr(keys[i], eq + 1)
      }
    }
    {
      arrow = index($1, " → ")
      if (!arrow) { print; next }
      combo = substr($1, 1, arrow - 1)
      action = substr($1, arrow + length(" → "))
      sub(/[ \t]+$/, "", combo)

      plus = index(combo, " + ")
      if (plus) { mods = substr(combo, 1, plus - 1); key = substr(combo, plus + 3) }
      else      { mods = ""; key = combo }

      delete have
      m = split(mods, parts, " ")
      for (i = 1; i <= m; i++) if (toupper(parts[i]) in rank) have[rank[toupper(parts[i])]] = 1
      out = ""
      for (i = 1; i <= 4; i++) if (i in have) out = out word[i] "-"

      upper = toupper(key)
      if (upper in name) key = name[upper]
      else if (upper ~ /^XF86/) { key = substr(key, 5); gsub(/[A-Z][a-z]+/, " &", key); sub(/^ /, "", key) }

      $1 = sprintf("%-34s → %s", out key, action)
      print
    }'
}

records="$(output_binding_records | macify)"

if [[ ${1-} == "--print" || ${1-} == "-p" ]]; then
  cut -f1 <<<"$records"
  exit 0
fi

selection="$(cut -f1 <<<"$records" | omarchy-menu-select 'Keybindings' -- --width 800 --height 500)"

if [[ -n $selection ]]; then
  record="$(awk -F '\t' -v selection="$selection" '$1 == selection { print; exit }' <<<"$records")"
  dispatch_binding "$(cut -f2 <<<"$record")" "$(cut -f3- <<<"$record")"
fi
